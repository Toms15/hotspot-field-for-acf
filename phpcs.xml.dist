<?xml version="1.0"?>
<ruleset name="Hotspot Field for ACF">
	<description>Coding standards for Hotspot Field for ACF.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/.wp-env-plugins/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/test-results/*</exclude-pattern>
	<exclude-pattern>/playwright-report/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.8"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="hotspot-field-for-acf"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="HotspotFieldForAcf"/>
				<element value="hotspot_field"/>
			</property>
			<!-- Lets classes extending the shared test case skip the prefix rule like other test classes. -->
			<property name="custom_test_classes" type="array">
				<element value="Hotspot_Field_Test_Case"/>
			</property>
		</properties>
	</rule>

	<!-- Test classes follow PHPUnit naming conventions. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
