{
	"name": "hotspot-field-for-acf",
	"version": "1.0.0",
	"private": true,
	"description": "Development tooling for the Hotspot Field for ACF WordPress plugin.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"env:acf-pro": "node scripts/install-acf-pro.mjs",
		"env:start": "npm run env:acf-pro && wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"wp-env": "wp-env",
		"lint:php": "composer lint",
		"plugin-check": "node scripts/plugin-check.mjs",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/hotspot-field-for-acf vendor/bin/phpunit",
		"test:e2e": "playwright test",
		"test": "npm run lint:php && npm run plugin-check && npm run test:php && npm run test:e2e",
		"build": "bash scripts/build.sh"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@wordpress/env": "^12.2.0"
	}
}
